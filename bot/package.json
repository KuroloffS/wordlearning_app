{
  "name": "wordlearning-bot",
  "version": "1.0.0",
  "description": "Telegram bot for learning words with spaced repetition (Supabase storage)",
  "private": true,
  "type": "module",
  "main": "src/index.js",
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "test": "node --test test/*.test.js",
    "build:edge": "node scripts/build-edge.mjs",
    "check:edge": "node scripts/build-edge.mjs --check"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.118.0",
    "grammy": "1.45.1"
  }
}
