# Telegram bot token from @BotFather
BOT_TOKEN=123456789:AA...

# Supabase → Project Settings → API (or Data API)
SUPABASE_URL=https://your-project-ref.supabase.co
# The service_role / secret key. Keep it on the server only — never put it in a web page or app.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Optional
# REMINDER_CHECK_SECONDS=60   # how often to look for due words
# REMINDER_GAP_MINUTES=180    # at most one reminder per user every N minutes
# REMINDER_IDLE_MINUTES=20    # don't remind someone who used the bot in the last N minutes
# PORT=3000                   # expose a health-check endpoint (needed by some hosts)
# DB=memory                   # run without Supabase (data lost on restart) — for quick local tests
