# Local development only (long polling). The production bot runs as a Supabase Edge Function —
# see README.md. Use a separate test bot here: long polling disconnects the production webhook.

# Telegram bot token from @BotFather
BOT_TOKEN=123456789:AA...

# Supabase → Project Settings → API Keys
SUPABASE_URL=https://givkncacizyipeipzzjl.supabase.co
# The secret key (sb_secret_...) or the legacy service_role key. Server side only — never share it.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...

# Optional
# DB=memory                   # run without Supabase (data lost on restart)
# MYMEMORY_EMAIL=you@example.com   # higher free translation quota
# REMINDER_CHECK_SECONDS=60
# REMINDER_GAP_MINUTES=180
# REMINDER_IDLE_MINUTES=20
# PORT=3000                   # health-check endpoint for hosts that need one
